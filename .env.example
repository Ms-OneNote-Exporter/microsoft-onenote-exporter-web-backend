# Copy to .env and fill in. .env is gitignored.
#
# This file documents every variable the backend reads. It is deliberately
# explicit about which component owns which value, because in PLAN-v3 those
# components have different trust levels: the api cannot see the vault, the
# orchestrator cannot see the internet, and Caddy can read artifacts but not
# the vault. PLANNING/PLAN-v3.md §2.1.

# infra
# ---------------------------------------------------------------------------

# The public host name of the API. THE single knob: compose feeds it to Caddy (as
# the site address) and to the api (as https://$PUBLIC_HOST -> PUBLIC_ORIGIN).
# Changing the domain is therefore one edit.
#
# Required, marked ${VAR:?} in compose, so a typo is a startup failure rather than a
# deployment on the wrong origin where every artifact download URL in every
# snapshot is silently wrong.
#
# Keep in sync with mac's frontend build (VITE_API_ORIGIN). Exact origin: no path,
# no trailing slash, https.
PUBLIC_HOST=one-backend.phttp.com

# The commit the running images are built from, surfaced as `build` on
# /api/public/version.
#
# Required. Without it the api reports itself as a local run, which on a live host
# with a real certificate is actively misleading rather than merely untidy. It is
# descriptive only — the compatibility meaning is in `protocol`, which is what a
# client pins.
#
# Set it to the commit you deployed:
#     git rev-parse --short HEAD
IMAGE_TAG=

# ACME contact for TLS issuance.
ACME_EMAIL=

# Where the operator's secret files live. Each is a 256-bit base64url value, 43
# characters, mode 0400. Generate with:
#     openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
#
# **Required, and absolute.** compose resolves a `secrets:` entry's `file:` to an
# absolute path but leaves an environment value verbatim, so a relative `SECRETS_DIR`
# gives the orchestrator a *relative* `ORCH_RUNNER_TOKEN_FILE` — which it then hands
# the Engine as a bind source, and a bind source must be absolute. It refuses to start
# with `ORCH_RUNNER_TOKEN_FILE must be absolute, got "./secrets/runner_token"`.
#
# A relative default was therefore a configuration that could not work, and the two
# derived paths disagreed in a way only an assertion comparing them could see.
SECRETS_DIR=/opt/msout/secrets

# Runner pool size. §2.1.
#
# compose passes this to the orchestrator as ORCH_POOL_SIZE. Note that: the
# orchestrator reads only ORCH_-prefixed variables, so an unprefixed name is
# silently ignored and the pool comes up at its built-in default instead. That is
# a real deploy failure that was found by deploying.
POOL_SIZE=2

# The host's docker group GID, which the orchestrator needs to reach the socket:
#
#     getent group docker | cut -d: -f3
#
# The orchestrator image runs as uid 1000 (the runner's uid — see VAULT_HOST_DIR)
# and the host
# socket is root:docker mode 0660, so without this group it cannot open the socket
# and dies with "permission denied". `group_add` rather than running as root,
# because root would work and would discard the reason the orchestrator is a
# separate component at all.
_DOCKER_GID=

# ---------------------------------------------------------------------------
# api
# ---------------------------------------------------------------------------

# Exact origins allowed to call this API. No wildcard, no trailing slash, no
# path, https only. The api refuses to start on a malformed value rather than
# falling back to something permissive - PLAN-v3 §3.3, test T-C6.
# Comma-separated, e.g. https://www.example.com
ALLOWED_ORIGINS=

# The origin this service is reached at, e.g. https://one-backend.example.com.
# Required. Bare origin, no path, https only (http on loopback in development).
#
# Artifact download URLs are built from this and are absolute, which is not a
# style choice. The session cookie is __Host-msout, and that prefix forbids a
# Domain attribute, so the browser only ever sends it to *this* host. A relative
# /files/<id> would resolve against the frontend's origin, where the cookie
# cannot travel - so Caddy's forward_auth would receive no Cookie header and
# refuse every download. SameSite=None does not help: SameSite governs site, not
# host. See api/src/cookies.ts and PLAN-v3 §5.
#
# Operator configuration rather than an X-Forwarded-Host lookup on purpose: a
# request header in this path would let a second operator's proxy redirect a
# user's artifact download.
PUBLIC_ORIGIN=

# Operator-supplied 256-bit secret, base64url, exactly 43 characters. Used to
# derive the per-session CSRF key. Generate with:
#     openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
# A value of the wrong length is rejected at startup, not coerced.
CSRF_KEY=

# How long a session (and its auth.json + exported artifacts) survives.
SESSION_TTL_HOURS=12

# Refuse to start an export when the host has less free space than this.
MIN_FREE_DISK_MB=2048

# Host paths for the orchestrator's two storage roots. The api is given neither
# tree as a mount; it asks the orchestrator to stat artifacts on its behalf -
# PLAN-v3 §2.2.
#
# These must be **absolute host paths, mounted by the orchestrator at the identical
# path**. They are the `Source` of a bind mount in every container the orchestrator
# creates, and a bind source is resolved by the Engine on the *host*: a path that
# only exists inside the orchestrator's container resolves to an empty root-owned
# directory the Engine creates, which every runner then mounts as `/data` and cannot
# write to (`EACCES: permission denied, mkdir '/data/<guid>'`).
#
# So they are host directories rather than named volumes. Create them once, owned by
# the uid both the orchestrator and the runner run as, before the first start:
#
#     install -d -o 1000 -g 1000 /opt/msout/data/vault /opt/msout/data/artifacts
#
# The orchestrator checks both at boot and refuses to start with that exact command
# in the message, so a wrong owner is a named startup error rather than an EACCES
# inside a runner three layers away.
VAULT_HOST_DIR=/opt/msout/data/vault
ARTIFACT_HOST_DIR=/opt/msout/data/artifacts

# api log level: debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# api -> orchestrator
# ---------------------------------------------------------------------------

# HMAC secret for signed internal calls. Supplied as a Docker secret, not an
# env var: the orchestrator must refuse to start when it is absent rather than
# fall back to open access - PLAN-v3 §2.1, test T-I6. The api holds this
# secret; nothing else on the host does.
ORCHESTRATOR_URL=http://orchestrator:9100
ORCHESTRATOR_HMAC_SECRET_FILE=/run/secrets/orchestrator_hmac

# Replay window for internal calls, in seconds. A 60s window absorbs ordinary
# clock skew between the two containers and still rejects a replayed request.
ORCHESTRATOR_REPLAY_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# runner sidecar
# ---------------------------------------------------------------------------

# Shared secret between the api and the runner sidecar. The api presents it on
# every runner request. Generate with:
#     openssl rand -hex 32
RUNNER_TOKEN=

# The image the orchestrator creates runner containers from.
#
# Set it to the tag `publish.yml` reported in its job summary, which is the commit
# SHA. There is deliberately no default here: the orchestrator has a built-in one
# that names an image nobody publishes, and leaving it unset means discovering that
# through a failed login rather than through this file.
#
# The deploy host needs a `repo`-scoped token to PULL a private package:
#   docker login ghcr.io -u <account> --password-stdin <<< "$TOKEN"
RUNNER_IMAGE=ghcr.io/ms-one-note-exporter/msout-runner:<commit>

# A runner's CPU allowance in billionths of a core (2000000000 = 2 cores).
#
# Set it to the host's core count or lower. Above it the Engine rejects the whole
# container create, the pool stays empty, and every login reports the pool as busy.
# Multiply by POOL_SIZE: that is the CPU the host has to cover.
RUNNER_NANO_CPUS=2000000000

# The runner container's memory ceiling.
#
# Size it to what the host has, minus room for the api, the orchestrator, caddy and
# Docker itself. A limit larger than the machine is not a cap the kernel can honour
# on its own: on a 3 GB VPS a Chromium spike takes the host into swap or the OOM
# killer, and what dies may be the api rather than the runner.
#
# `shm_size` (1 GB, set in docker-compose.yml) is a separate shared-memory mount and
# is deliberately NOT scaled with this — Chromium crashes on Docker's 64 MB
# /dev/shm default, so it stays where it is.
RUNNER_MEMORY_LIMIT=2g

# How many runners exist when idle. Each one is a full Chromium, so this multiplies
# the memory and CPU cost: POOL_SIZE × RUNNER_MEMORY_LIMIT must fit the host.
POOL_SIZE=1

# Hard limits on a single child process. Enforced by the runner, which is where
# the child lives: a login that hangs on an unanswered MFA prompt, or an export
# that wedges, is killed rather than waited on forever.
LOGIN_TIMEOUT_MS=900000
EXPORT_TIMEOUT_MS=5400000

# One env var honoured by all three @msout packages, so every app.log and
# HTML dump lands inside the session directory and dies with it on erase.
ONENOTE_EXPORT_LOG_DIR=/data/logs

# Set to 1 ONLY on a host that cannot enable unprivileged user namespaces.
# This disables Chromium's renderer sandbox - the reason a browser exists in
# the runner at all. PLAN-v3 §5.2, and the sandbox integration test is the
# gate for everything after it.
CHROMIUM_NO_SANDBOX=0

# ---------------------------------------------------------------------------
# local development only
# ---------------------------------------------------------------------------

# 1 makes the runner spawn fake CLIs that emit the real packages' log lines, so
# the whole pipeline can be exercised with no Microsoft account and no Chromium
# download. Leave at 0 for anything real.
MSOUT_FAKE=0
