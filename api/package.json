{
  "name": "@msout/api",
  "version": "0.0.0",
  "private": true,
  "description": "Public API: session state, pool manager, SSE hub, credential forwarder, CORS/CSRF, rate limits. No Docker socket, no vault mount, no egress.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "undici": "7.3.0"
  },
  "devDependencies": {
    "@types/node": "22.13.5",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "5.0.3"
  }
}
