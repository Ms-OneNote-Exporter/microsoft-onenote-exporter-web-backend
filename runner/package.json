{
  "name": "@msout/runner",
  "version": "0.0.0",
  "private": true,
  "description": "Runner sidecar: the only component that sees the credential bytes. Spawns the unmodified @msout CLIs for one session at a time.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "fake": "MSOUT_FAKE=1 tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@msout/microsoft-onenote-export-notebook": "0.4.0",
    "@msout/microsoft-onenote-list-notebooks": "0.0.7",
    "@msout/microsoft-webauth": "0.1.9",
    "archiver": "7.0.1",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/node": "22.13.5",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "5.0.3"
  }
}
